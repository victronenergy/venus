#!/bin/sh

root=$PWD;
PATH="$PWD:$PATH"
DOECHO=1

do_echo() {
	if [ ${DOECHO} -eq 1 ]; then
		echo "$@"
	fi
}

if [ "${1}" = "-q" ]; then
        DOECHO=0
        shift
fi

do_echo "----------------- $@ -----------------------"
repos=`find sources -mindepth 1 -maxdepth 1 -type d  ! -path '*.*' | sort`

if [ -d "install" ]; then
	repos="${repos} install"
fi

result=0
for repo in $repos; do
	. $root/build/prop.`basename $repo`
	do_echo
	do_echo $repo:
	cd "$root/$repo" && eval "$@" || result=1
done
cd $root

do_echo
exit "$result"
